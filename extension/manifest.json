{
	"manifest_version": 3,
	"name": "Job Logger",
	"version": "0.1.0",
	"description": "Log job applications to my Google Sheet in one click.",
	"action": {
		"default_popup": "popup.html",
		"default_title": "Log this job"
	},
	"permissions": ["activeTab", "scripting", "storage"],
	"host_permissions": [
		"https://script.google.com/*",
		"https://script.googleusercontent.com/*"
	]
}
